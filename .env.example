SAC_SIGNING_SEED_B64=replace-with-base64-encoded-32-byte-value
SAC_CHANNEL_KEY_A_B64=replace-with-base64-encoded-32-byte-value
SAC_CHANNEL_KEY_B_B64=replace-with-base64-encoded-32-byte-value
DEVICE_ROOT_B64=replace-with-base64-encoded-32-byte-value
LEDGER_EPOCH_DIGEST_B64=replace-with-base64-encoded-32-byte-value
LEDGER_MODE=simulated
LEDGER_SIMULATED_FINALITY_MS=12000
LEDGER_WORKER_COUNT=64

# Experiment C. These values are ignored while LEDGER_MODE=simulated.
# The binary must target Linux because it is mounted inside the container.
IOTA_RPC_URL=https://api.testnet.iota.cafe
IOTA_PACKAGE_ID=0xREPLACE_WITH_PUBLISHED_PACKAGE_ID
IOTA_CLI_BINARY=/absolute/path/to/linux/iota
IOTA_CLIENT_CONFIG_DIR=/absolute/path/to/funded/iota-client-config
IOTA_LEDGER_WORKER_COUNT=1
IOTA_MOVE_MODULE=commitment_registry
IOTA_MOVE_FUNCTION=submit
IOTA_GAS_BUDGET=10000000
IOTA_COMMITMENT_TAG_HEX=73706c69742d74727573742d76310000
IOTA_POLL_INTERVAL_SECONDS=1
IOTA_SUBMIT_TIMEOUT_SECONDS=60
IOTA_CONFIRMATION_TIMEOUT_SECONDS=60
